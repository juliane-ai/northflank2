# 复制为 Northflank Secrets / 本地 .env；带默认值的可省略
NEW_API_KEY=sk-xxx

NEW_API_BASE=https://ai--new-api--7jgxq8y8tx2h.code.run
RESEARCH_MODEL=nvidia/nemotron-3-super-120b-a12b
RESEARCH_INTERVAL_SECONDS=21600
RESEARCH_FIRST_DELAY_SECONDS=120
ROUND_TIMEOUT_SECONDS=3600

# R2 加密备份（可选，默认关闭；当前产出走 GitHub 仓库，无需配置）
BACKUP_WORKER_URL=https://cloudflare-docker-storage.564510493.workers.dev
BACKUP_WORKER_API_KEY=
BACKUP_PASSWORD=
BACKUP_OBJECT_KEY=northflank2/data.tar.gz.enc
RESTORE_IF_DATA_EXISTS=false
SCHEDULED_BACKUP_ENABLED=false
SCHEDULED_BACKUP_TIME=03:30

# ---- 研究产出 → 私有 GitHub 仓库（issue + PR 流程）----
# 主持久化通道：每轮结束后全量 /opt/data 同步到仓库 data/（含会话记忆，排除密钥），新研报各开 issue，分支提交并开 PR；启动时本地无数据自动从仓库恢复
GITHUB_PAT=github_pat_xxx          # fine-grained PAT：Contents+Issues+Pull requests 读写
GITHUB_REPO=lumincc/okx-24-research
# GITHUB_BASE=main                 # 目标分支，默认 main

# 研究搜索服务（SearXNG JSON API，已部署在 Northflank）
SEARCH_API_URL=https://p01--g02-ritup-repo01-search--4ygvmqls7l8l.code.run/search
